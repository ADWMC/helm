{
	"name": "@adwmc/helm-tools",
	"version": "0.87.1",
	"description": "helm host tools: task subagent executor (spawn/steer/kill, oh-my-pi four-piece basis)",
	"type": "module",
	"license": "MIT",
	"files": [
		"dist",
		"src"
	],
	"exports": {
		".": {
			"source": "./src/task.ts",
			"types": "./src/task.ts",
			"import": "./dist/task.js"
		},
		"./task": {
			"source": "./src/task.ts",
			"types": "./src/task.ts",
			"import": "./dist/task.js"
		}
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "node --test src/*.test.ts"
	},
	"dependencies": {
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@adwmc/helm-agent-core": "^0.87.1"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
