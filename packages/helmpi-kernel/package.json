{
  "dependencies": {
    "@adwmc/helm-ai": "^0.87.1",
    "@adwmc/helm-tui": "^0.87.1",
    "typebox": "1.3.27"
  },
  "type": "module",
	"exports": {
		"./spec-lint": {
			"source": "./src/spec-lint.ts",
			"types": "./src/spec-lint.ts",
			"import": "./dist/spec-lint.js"
		},
		"./guard": {
			"source": "./src/guard/cai.ts",
			"types": "./src/guard/cai.ts",
			"import": "./dist/guard/cai.js"
		},
		"./i18n": {
			"source": "./src/i18n/index.ts",
			"types": "./src/i18n/index.ts",
			"import": "./dist/i18n/index.js"
		},
		"./i18n/en.json": "./i18n/en.json",
		"./i18n/zh-CN.json": "./i18n/zh-CN.json",
		"./memory": {
			"source": "./src/memory/tool-memory.ts",
			"types": "./src/memory/tool-memory.ts",
			"import": "./dist/memory/tool-memory.js"
		},
		"./config": {
			"source": "./src/config-schema.ts",
			"types": "./src/config-schema.ts",
			"import": "./dist/config-schema.js"
		},
		"./package.json": "./package.json",
		".": {
			"source": "./src/index.ts",
			"types": "./src/index.ts",
			"import": "./dist/index.js"
		},
		"./scope": {
			"source": "./src/domain/scope.ts",
			"types": "./src/domain/scope.ts",
			"import": "./dist/domain/scope.js"
		},
		"./export": {
			"source": "./src/export.ts",
			"types": "./src/export.ts",
			"import": "./dist/export.js"
		},
		"./ledger": {
			"source": "./src/ledger.ts",
			"types": "./src/ledger.ts",
			"import": "./dist/ledger.js"
		}
	},
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "helm kernel: gates/evidence/ledger/playbook/report (migrated from helm-pi)",
  "license": "MIT",
  "name": "@adwmc/helm-kernel",
  "files": [
    "dist",
    "src",
    "i18n",
    "references",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@adwmc/helm-coding-agent": "0.87.1"
  },
  "version": "0.87.1",
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsgo -p tsconfig.build.json",
    "test": "node --test --test-concurrency=1 src/*.test.ts src/memory/*.test.ts src/guard/*.test.ts src/runtime/*.test.ts && vitest run"
  },
  "devDependencies": {
    "@adwmc/helm-coding-agent": "0.87.1"
  },
  "peerDependenciesMeta": {
    "@adwmc/helm-coding-agent": {
      "optional": false
    }
  }
}
