{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"@adwmc/helm-chord": ["./packages/chord/src/index.ts"],
			"@adwmc/helm-chord/bundler": ["./packages/chord/src/bundler.ts"],
			"@adwmc/helm-chord/context": ["./packages/chord/src/context/index.ts"],
			"@adwmc/helm-chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@adwmc/helm-chord/node": ["./packages/chord/src/node.ts"],
			"@adwmc/helm-telemetry": ["./packages/telemetry/src/index.ts"],
			"@adwmc/helm-telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@adwmc/helm-ai": ["./packages/ai/src/index.ts"],
			"@adwmc/helm-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@adwmc/helm-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@adwmc/helm-ai/dist/*": ["./packages/ai/src/*"],
			"@adwmc/helm-durable": ["./packages/durable/src/index.ts"],
			"@adwmc/helm-durable/testing": ["./packages/durable/src/testing/index.ts"],
			"@adwmc/helm-durable/*": ["./packages/durable/src/*"],
			"@adwmc/helm-agent-core": ["./packages/agent/src/index.ts"],
			"@adwmc/helm-agent-core/harness/session/testing": [
				"./packages/agent/src/harness/session/testing/index.ts"
			],
			"@adwmc/helm-agent-core/experimental/pico3": [
				"./packages/agent/src/harness/pico3/index.ts"
			],
			"@adwmc/helm-agent-core/node": ["./packages/agent/src/node.ts"],
			"@adwmc/helm-agent-core/*": [
				"./packages/agent/src/*.ts",
				"./packages/agent/src/*/index.ts",
				"./packages/agent/src/*"
			],
			"@adwmc/helm-session-backend-sqlite-node": ["./packages/session-backends/sqlite-node/src/index.ts"],
			"@adwmc/helm-coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@adwmc/helm-coding-agent/experimental/plugin": [
				"./packages/coding-agent/src/experimental/plugin.ts"
			],
			"@adwmc/helm-coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@adwmc/helm-coding-agent/*": ["./packages/coding-agent/src/*"],
			"@adwmc/helm-protocol": ["./packages/protocol/src/index.ts"],
			"@adwmc/helm-protocol/*": ["./packages/protocol/src/*"],
			"@adwmc/helm-client": ["./packages/client/src/index.ts"],
			"@adwmc/helm-client/unix": ["./packages/client/src/unix.ts"],
			"@adwmc/helm-client/*": ["./packages/client/src/*"],
			"@adwmc/helm-server": ["./packages/server/src/index.ts"],
			"@adwmc/helm-server/unix": ["./packages/server/src/transports/unix/index.ts"],
			"@adwmc/helm-server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@adwmc/helm-tui": ["./packages/tui/src/index.ts"],
			"@adwmc/helm-tui/*": ["./packages/tui/src/*"],
			"@adwmc/helm-agent-old": ["./packages/agent-old/src/index.ts"],
			"@adwmc/helm-agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["scripts/model-catalog-protocol.ts", "scripts/model-catalog-protocol.test.ts", "packages/*/src/**/*", "packages/*/test/**/*", "packages/session-backends/*/src/**/*", "packages/session-backends/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
